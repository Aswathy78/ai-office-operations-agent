# Example environment configuration.
# Never put real API keys or encryption secrets in this file.

# GROQ_API_KEY: Groq API key for AI meeting summary generation. Replace the
# placeholder locally with a key; never put a real key in this example file.
GROQ_API_KEY=your-groq-api-key

# Groq model used for meeting summaries.
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b

# RECORDING_ENCRYPTION_KEY: Base64-encoded 32-byte key used to encrypt
# recordings. Generate a unique local key; never use a real key in this file.
RECORDING_ENCRYPTION_KEY=base64-encoded-32-byte-key

ORGANIZATION_TIMEZONE=Asia/Kolkata
FRONTEND_BASE_URL=http://localhost:5173

# SMTP settings for assignment and notification email delivery:
# SMTP_HOST: provider SMTP server hostname.
# SMTP_PORT: provider SMTP port (587 is the submission port for Gmail).
# SMTP_FROM_EMAIL: verified sender address.
# SMTP_USERNAME: provider SMTP authentication username.
# SMTP_PASSWORD: for Gmail this must be an APP PASSWORD (16 letters, spaces optional), made at
#   Google Account > Security > 2-Step Verification > App passwords, in the SAME account as
#   SMTP_USERNAME. The normal account password is rejected. Saving this file is enough:
#   the API re-reads the mail settings by itself, no restart needed.
# SMTP_USE_STARTTLS: upgrade the connection with STARTTLS (true for port 587).
# Replace all example credentials locally; never place real credentials here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your-sender@example.com
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_STARTTLS=true
# Transcription worker device: "cuda" (NVIDIA GPU, default) or "cpu".
WHISPER_DEVICE=cpu
# Optional: override compute type (default float16 on CUDA, int8 on CPU).
# WHISPER_COMPUTE_TYPE=int8

# --- E-mail retry, fallback and escalation (Story 4.6 / FR-23) ---
# Retries: up to EMAIL_MAX_ATTEMPTS attempts, waiting 1, 5, 15 minutes (then 15) between them.
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_RETRY_BACKOFF_MINUTES=1,5,15
# Backup mail provider used when the primary SMTP (Gmail) is unavailable.
# Amazon SES works through its SMTP interface:
# FALLBACK_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# FALLBACK_SMTP_PORT=587
# FALLBACK_SMTP_USERNAME=
# FALLBACK_SMTP_PASSWORD=
# FALLBACK_SMTP_FROM_EMAIL=          # defaults to SMTP_FROM_EMAIL (must be a verified SES sender)
# FALLBACK_SMTP_USE_STARTTLS=true
# Administrators e-mailed when an e-mail finally fails (they always get an in-app record too).
# SYSTEM_ADMIN_EMAILS=it-admin@example.com,ops-admin@example.com
# Shared secret for POST /api/v1/email-drafts/bounces (header X-Bounce-Webhook-Token).
# EMAIL_BOUNCE_WEBHOOK_TOKEN=

# --- Task deadline calendar sync (Story 5.5 / FR-28) ---
# Uses CALENDAR_PROVIDER (default "local"); the local provider stores entries in the app database.
# TASK_CALENDAR_SYNC_ENABLED=true
# TASK_CALENDAR_SYNC_INTERVAL_SECONDS=15     # push new / changed deadlines
# TASK_CALENDAR_POLL_INTERVAL_SECONDS=300    # poll the provider for external changes (5 minutes)
# CALENDAR_SYNC_MAX_ATTEMPTS=5
# CALENDAR_SYNC_BACKOFF_MINUTES=1,5,15
# CALENDAR_DEADLINE_REMINDER_MINUTES=60      # reminder before each deadline

# --- Document upload and processing (Story 7.1 / FR-37) ---
# DOCUMENT_STORAGE_PATH=storage/documents
# DOCUMENT_MAX_SIZE_MB=50
# DOCUMENT_PROCESSOR_ENABLED=true
# DOCUMENT_PROCESSOR_INTERVAL_SECONDS=5
# TESSERACT_CMD=   # Optional: path to tesseract binary if not on PATH

# --- Development conveniences (all optional) ---------------------------------------------
# APP_ENV: development (default) or production. In production the two switches below default
#   to off, so no demo accounts are created and the database is never changed on its own.
# AUTO_MIGRATE: true/false. When the database is behind the code, back it up and upgrade it
#   at start-up instead of failing later with a missing table or column.
# SEED_DEFAULT_ACCOUNTS: true/false. Create the demo logins listed in app/db/seed_accounts.py
#   at start-up if they are missing (an existing account keeps its password).
# TESSERACT_CMD: full path to tesseract.exe if OCR is installed somewhere unusual. It is also
#   found automatically in C:\Program Files\Tesseract-OCR.
# Check the whole set-up at any time:  python -m app.doctor

# --- Sign in with Google / Microsoft and sessions (Story 10.1 / FR-56) -------------------
# Provider credentials live ONLY here (this file is git-ignored). Never put them in code.
# Both providers are optional: a button appears on the sign-in page only when its settings
# are complete. Password sign-in keeps working either way.
#
# Where the provider sends people back to (register this exact address with the provider):
#   <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/google/callback
#   <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/microsoft/callback
# OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000    # the address of THIS API, as the browser sees it
# FRONTEND_BASE_URL=http://localhost:5173          # where people land after signing in
#
# Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, "Web application")
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_ALLOWED_DOMAIN=yourcompany.com      # optional: only this Google Workspace domain
#
# Microsoft Entra ID (Azure portal > Microsoft Entra ID > App registrations > New registration)
# A specific tenant is required ("common" and "organizations" are refused): Entra does not verify
# the e-mail address another tenant puts in its tokens.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=                       # your Directory (tenant) ID
#
# Tokens and sessions
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900                # access tokens last 15 minutes
# AUTH_IDLE_TIMEOUT_SECONDS=1800                   # sign out after 30 minutes without activity
# AUTH_REFRESH_TOKEN_TTL_SECONDS=86400             # each single-use refresh token lasts 24 hours
# AUTH_SESSION_MAX_AGE_SECONDS=604800              # a sign-in ends after 7 days at most
